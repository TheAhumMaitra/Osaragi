Screen {
  margin: 0;
  padding: 0;
}

Welcome {
  width: 100%;
  height: 3;
  padding: 1 2;
  margin: 1 0 1 0;
  align: center middle;
  text-align: center;
}
AddTask {
  margin: 2;
  layout: vertical;
  padding: 1;
}
AddTask Label {
  content-align: center middle;
  text-style: bold;
  height: 3;

  padding: 1;
  text-style: bold;

}
AddTask Button {
  margin: 2 0 0 0;

}
#task_text{
  margin: 3;

}
#show_task{
  margin: 3;
}
#help_panel_sidebar {
    dock: left;
    width: 100;  /* Set a fixed width (in columns) */
    padding: 1 2;
    text-wrap: wrap;
}

/* Define the class that hides the widget */
.hidden {
    display: none;
}

.help_title {
    text-align: center;
    text-style: bold underline;
    margin-bottom: 1;
}
